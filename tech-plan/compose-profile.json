{
  "profile_id": "tech-plan",
  "stage_name": "tech-plan",
  "cycle_types": ["feature"],
  "shell_dir": "tech-plan",
  "shell_paths": {
    "hook_guard": "scripts/hook/hook_guard.py",
    "dimension_defs_dir": "tech-plan/dimension-defs"
  },
  "document": {
    "filename": "tech-doc.md",
    "schema": "section-keyed"
  },
  "drafting": {
    "inductive": false,
    "freeedit": true,
    "post_init_options": ["freeedit", "evaluate", "deliver"]
  },
  "start": {
    "adapter_module": "tech-plan/scripts/start/tech_plan_start_adapter.py",
    "adapter_class": "TechPlanStartAdapter"
  },
  "cache_subdir": "tech/plan",
  "framework_section": "tech-plan",
  "framework_templates": {
    "section-registry": "tpt_section_registry_url",
    "section-form-registry": "tpt_section_form_registry_url",
    "section-kw-criteria": "tpt_section_kw_criteria_url",
    "outline-registry": "tpt_outline_registry_url",
    "role-instance": "tpt_feature_role_instance_url",
    "domain-instance": "tpt_feature_domain_instance_url"
  },
  "eval": {
    "enabled": true,
    "workflow_id": "tech-plan",
    "adapter_module": "tech-plan/scripts/eval/tech_plan_eval_adapter.py",
    "adapter_class": "TechPlanEvalAdapter"
  },
  "delivery_index": {
    "layout": "revision",
    "state_file": "workflow-state.md",
    "terminal_state": "Delivered",
    "doc_filename": "tech-doc.md"
  }
}
