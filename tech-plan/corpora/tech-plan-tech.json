{
  "id": "tech-plan-tech",
  "version": "4",
  "scope": "tech-plan",
  "context": "offline",
  "dimension_dispatch": "parallel",
  "dimensions": [
    {
      "id": "codebase-consistency",
      "legacy_alias": "e2",
      "label": "Codebase Consistency",
      "eval_target": {
        "path": "{tech_doc}"
      },
      "remediation_target": {
        "path": "{tech_doc}"
      },
      "sots": [
        {
          "kind": "codebase",
          "role": "primary",
          "ref": {
            "root": ".",
            "strategy": "all"
          }
        }
      ],
      "method": {
        "kind": "builtin",
        "source": {
          "procedure_id": "codebase_consistency"
        },
        "focus": "Design vs existing code structure, references, conventions"
      },
      "review": {
        "seq": 2,
        "output_path": "tech-review-e{M}2.md",
        "template": "eval/review.template.md"
      }
    },
    {
      "id": "solution-quality",
      "legacy_alias": "e3",
      "label": "Solution Quality (Intent Probes)",
      "eval_target": {
        "path": "{tech_doc}"
      },
      "remediation_target": {
        "path": "{tech_doc}"
      },
      "sots": [
        {
          "kind": "url",
          "role": "primary",
          "ref": "{tpt_intent_gap_probes_url}"
        }
      ],
      "method": {
        "kind": "external",
        "source": "{tpt_intent_eval_framework_url}",
        "focus": "P1–P4 intent gap probes — semantic fidelity, boundaries, derivability, edge cases"
      },
      "review": {
        "seq": 3,
        "output_path": "tech-review-e{M}3.md",
        "template": "eval/review.template.md"
      }
    }
  ]
}
