{
  "id": "tech-plan-tech",
  "version": "2",
  "scope": "tech-plan",
  "context": "offline",
  "dimension_dispatch": "parallel",
  "dimensions": [
    {
      "id": "codebase-consistency",
      "legacy_alias": "e2",
      "label": "Codebase Consistency",
      "eval_target": {
        "path": "{tech_doc}"
      },
      "remediation_target": {
        "path": "{tech_doc}"
      },
      "sots": [
        {
          "kind": "codebase",
          "role": "primary",
          "ref": {
            "discover_from": "{tech_doc}",
            "strategy": "approach_or_legacy_sections"
          }
        }
      ],
      "method": {
        "kind": "builtin",
        "source": {
          "procedure_id": "codebase_consistency"
        },
        "focus": "Design vs existing code structure, references, conventions"
      },
      "review": {
        "seq": 2,
        "output_path": "tech-review-e{M}2.md",
        "template": "eval/review.template.md"
      }
    },
    {
      "id": "solution-quality",
      "legacy_alias": "e3",
      "label": "Solution Quality (TPEF)",
      "eval_target": {
        "path": "{tech_doc}"
      },
      "remediation_target": {
        "path": "{tech_doc}"
      },
      "sots": [
        {
          "kind": "url",
          "role": "primary",
          "ref": "{tpef_url}"
        }
      ],
      "method": {
        "kind": "builtin",
        "source": {
          "procedure_id": "tpef_solution_quality"
        },
        "focus": "TPEF / Shaping TPEF solution-quality standards"
      },
      "review": {
        "seq": 3,
        "output_path": "tech-review-e{M}3.md",
        "template": "eval/review.template.md"
      }
    }
  ]
}
