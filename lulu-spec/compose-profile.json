{
  "profile_id": "lulu-spec",
  "stage_name": "lulu-spec",
  "cycle_types": [
    "feature"
  ],
  "shell_dir": "lulu-spec",
  "shell_paths": {
    "hook_guard": "scripts/hook/hook_guard.py",
    "dimension_defs_dir": "lulu-spec/dimension-defs"
  },
  "document": {
    "filename": "product-doc.md",
    "schema": "chapter"
  },
  "pipeline": {
    "inductive": true,
    "freeedit": true,
    "code_grounding": false,
    "post_writing_options": [
      "freeedit",
      "evaluate"
    ]
  },
  "cache_subdir": "lulu-spec",
  "framework_section": "lulu-spec",
  "framework_templates": {
    "section-registry": "lulu-dev-workflow/lulu-spec/templates/section-registry.json",
    "section-form-registry": "lulu-dev-workflow/lulu-spec/templates/section-form-registry.json",
    "section-kw-criteria": "lulu-dev-workflow/lulu-spec/templates/section-kw-criteria.md",
    "role-instance": "lulu-dev-workflow/lulu-spec/templates/role-instance.json",
    "domain-instance": "lulu-dev-workflow/lulu-spec/templates/domain-instance.json"
  },
  "eval": {
    "enabled": true,
    "workflow_id": "lulu-spec",
    "contributor_module": "lulu-spec/scripts/eval/product_spec_eval_contributor.py",
    "contributor_class": "ProductSpecEvalContributor",
    "eval_capability": "full-remediation"
  },
  "delivery_index": {
    "layout": "revision",
    "state_file": "workflow-state.md",
    "terminal_state": "Delivered",
    "doc_filename": "product-package.json"
  },
  "demand_manifest": {
    "id_prefix": "SPEC",
    "unit_rule": "one demand per section-level product decision"
  }
}
