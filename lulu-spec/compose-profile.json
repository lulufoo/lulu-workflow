{
  "profile_id": "lulu-spec",
  "stage_name": "lulu-spec",
  "cycle_types": ["feature"],
  "shell_dir": "lulu-spec",
  "shell_paths": {
    "hook_guard": "scripts/hook/hook_guard.py",
    "dimension_defs_dir": "lulu-spec/dimension-defs"
  },
  "document": {
    "filename": "product-doc.md",
    "schema": "section-keyed"
  },
  "drafting": {
    "inductive": false,
    "freeedit": true,
    "post_init_options": ["freeedit", "evaluate", "deliver"]
  },
  "start": {
    "adapter_module": "lulu-spec/scripts/start/product_spec_start_adapter.py",
    "adapter_class": "ProductSpecStartAdapter"
  },
  "cache_subdir": "lulu-spec",
  "framework_section": "lulu-spec",
  "framework_templates": {
    "section-registry": "pst_section_registry_url",
    "section-form-registry": "pst_section_form_registry_url",
    "section-kw-criteria": "pst_section_kw_criteria_url",
    "outline-registry": "pst_outline_registry_url",
    "role-instance": "pst_feature_role_instance_url",
    "domain-instance": "pst_feature_domain_instance_url"
  },
  "eval": {
    "enabled": true,
    "workflow_id": "lulu-spec",
    "adapter_module": "lulu-spec/scripts/eval/product_spec_eval_adapter.py",
    "adapter_class": "ProductSpecEvalAdapter"
  },
  "delivery_index": {
    "layout": "revision",
    "state_file": "workflow-state.md",
    "terminal_state": "Delivered",
    "doc_filename": "product-doc.md"
  }
}
