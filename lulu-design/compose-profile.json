{
  "profile_id": "lulu-design",
  "stage_name": "lulu-design",
  "cycle_types": [
    "feature"
  ],
  "shell_dir": "lulu-design",
  "shell_paths": {
    "hook_guard": "scripts/hook/hook_guard.py",
    "dimension_defs_dir": "lulu-design/dimension-defs"
  },
  "document": {
    "filename": "design-doc.md",
    "schema": "chapter"
  },
  "pipeline": {
    "inductive": true,
    "freeedit": true,
    "code_grounding": true,
    "post_init_options": [
      "freeedit",
      "evaluate",
      "deliver"
    ]
  },
  "start": {
    "adapter_module": "lulu-design/scripts/start/tech_design_start_adapter.py",
    "adapter_class": "TechDesignStartAdapter"
  },
  "cache_subdir": "lulu-design",
  "framework_section": "lulu-design",
  "framework_templates": {
    "section-registry": "tdt_section_registry_url",
    "section-form-registry": "tdt_section_form_registry_url",
    "section-kw-criteria": "tdt_section_kw_criteria_url",
    "role-instance": "tdt_feature_role_instance_url",
    "domain-instance": "tdt_feature_domain_instance_url",
    "inductive-scan-criteria": "tdt_inductive_scan_criteria_url"
  },
  "eval": {
    "enabled": true,
    "workflow_id": "lulu-design",
    "adapter_module": "lulu-design/scripts/eval/tech_design_eval_adapter.py",
    "adapter_class": "TechDesignEvalAdapter"
  },
  "delivery_index": {
    "layout": "revision",
    "state_file": "workflow-state.md",
    "terminal_state": "Delivered",
    "doc_filename": "design-package.json"
  }
}
