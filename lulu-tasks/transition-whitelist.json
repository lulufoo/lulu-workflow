{
  "version": 1,
  "session": {
    "states": ["Drafting", "Evaluating", "Delivered"],
    "allowed_transitions": [
      {"from": "Drafting",     "to": "Evaluating"},
      {"from": "Evaluating",   "to": "Drafting"},
      {"from": "Evaluating",   "to": "ReadyForDelivery"},
      {"from": "ReadyForDelivery", "to": "Drafted"},
      {"from": "ReadyForDelivery", "to": "Delivered"}
    ]
  },
  "evaluate": {
    "phases": ["compliance-crosscheck", "execution-admission"]
  }
}
